{
  "name": "Retail",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "SalesPlan",
        "columns": [
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month",
            "summarizeBy": "none"
          },
          {
            "name": "Branch",
            "dataType": "string",
            "sourceColumn": "Branch",
            "summarizeBy": "none"
          },
          {
            "name": "Category",
            "dataType": "string",
            "sourceColumn": "Category",
            "summarizeBy": "none"
          },
          {
            "name": "Units",
            "dataType": "int64",
            "sourceColumn": "Units",
            "summarizeBy": "none"
          },
          {
            "name": "RevenueLKR",
            "dataType": "int64",
            "sourceColumn": "RevenueLKR",
            "summarizeBy": "none"
          },
          {
            "name": "CostLKR",
            "dataType": "int64",
            "sourceColumn": "CostLKR",
            "summarizeBy": "none"
          },
          {
            "name": "TargetLKR",
            "dataType": "int64",
            "sourceColumn": "TargetLKR",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Monthly plan",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Raw = Csv.Document(Binary.FromText(\"\", BinaryEncoding.Base64), [Delimiter=\",\", Encoding=65001]),",
                "    Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"Month\", type text}, {\"Branch\", type text}, {\"Category\", type text}, {\"Units\", Int64.Type}, {\"RevenueLKR\", Int64.Type}, {\"CostLKR\", Int64.Type}, {\"TargetLKR\", Int64.Type}})",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Sales",
            "expression": "SUM(SalesPlan[RevenueLKR])",
            "formatString": "\"LKR \" #,0;(\"LKR \" #,0);\"LKR \" 0"
          },
          {
            "name": "Sales Target",
            "expression": "SUM(SalesPlan[TargetLKR])",
            "formatString": "\"LKR \" #,0;(\"LKR \" #,0);\"LKR \" 0"
          },
          {
            "name": "Gap to Target",
            "expression": "[Sales] - [Sales Target]",
            "formatString": "\"LKR \" #,0;(\"LKR \" #,0);\"LKR \" 0"
          },
          {
            "name": "Attainment",
            "expression": "DIVIDE([Sales], [Sales Target])",
            "formatString": "0.0%"
          },
          {
            "name": "Gross Profit",
            "expression": "[Sales] - SUM(SalesPlan[CostLKR])",
            "formatString": "\"LKR \" #,0;(\"LKR \" #,0);\"LKR \" 0"
          },
          {
            "name": "Gross Margin",
            "expression": "DIVIDE([Gross Profit], [Sales])",
            "formatString": "0.0%"
          },
          {
            "name": "Units Sold",
            "expression": "SUM(SalesPlan[Units])",
            "formatString": "#,0"
          }
        ]
      }
    ]
  }
}